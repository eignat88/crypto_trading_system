# Exchange API Configuration
EXCHANGE_NAME=bybit
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crypto_trading
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/crypto_trading

# Trading Mode (paper | live)
TRADING_MODE=paper

# Risk Limits
MAX_RISK_PER_TRADE=0.005
MAX_POSITION_SIZE=0.10
MAX_ASSET_EXPOSURE=0.25
MAX_CAPITAL_UTILIZATION=0.60
DAILY_LOSS_LIMIT=0.02
WEEKLY_LOSS_LIMIT=0.05
MAX_DRAWDOWN=0.10

# Paper Trading
PAPER_INITIAL_BALANCE=5000.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# Monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
