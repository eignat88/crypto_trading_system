# Trading Mode (paper | live)
# live execution is NOT supported yet - will fail safely
TRADING_MODE=paper

# Bybit Environment (demo | testnet | mainnet)
BYBIT_ENVIRONMENT=demo

# Trading Symbols (comma-separated)
TRADING_SYMBOLS=BTCUSDT-SPOT,ETHUSDT-SPOT

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Logging
LOG_LEVEL=INFO
# Scheduled paper runtime (new entries only Mon-Fri inside this local-time window)
PAPER_RUNTIME_TIMEZONE=UTC
PAPER_RUNTIME_START=09:00
PAPER_RUNTIME_END=19:00
