```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage reports
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/

# System files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
*.env.*
```